###> API Configuration ###
# URL de base de l'API backend Symfony
API_BASE=https://api.tandems.social/
# URL du frontend (utilisée pour les CORS et redirections)
FRONTEND_URL=https://tandems.social
###< API Configuration ###

###> Matomo Configuration ###
# URL de votre instance Matomo pour les analytics
MATOMO_URL=https://matomo.tandems.social/
# ID du site dans Matomo
MATOMO_SITE_ID=1
# Configuration pour le module Nuxt Matomo
NUXT_PUBLIC_MATOMO_HOST=https://matomo.tandems.social/
NUXT_PUBLIC_MATOMO_CONTAINER_ID=1
###< Matomo Configuration ###

###> Stripe Configuration (Frontend) ###
# Clé publique Stripe (visible côté client)
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE
###< Stripe Configuration ###

###> Development Configuration ###
# Pour le développement local, utilisez ces valeurs :
# API_BASE=http://localhost:8888/
# FRONTEND_URL=http://localhost:3000
# MATOMO_URL=http://localhost:8080/
# STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE
###< Development Configuration ###
